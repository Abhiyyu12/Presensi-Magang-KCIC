# Local development only. Copy to .env and replace placeholders.
# Ports below are HOST ports for docker-compose (project presensi-kcic).
# Remapped from defaults because another local stack occupies 3000/5173/5432/9000/9001.
# Container-internal ports stay fixed: api 3000, web nginx 80, db 5432, minio 9000/9001.
# Host-dev mode (pnpm --filter api dev + vite) instead uses API_PORT=3000 and vite proxy -> 127.0.0.1:3000.
NODE_ENV=development
# Seed data dummy hanya untuk dev/test. api-migrate menjalankan seed hanya jika true;
# seed.ts juga menolak berjalan saat NODE_ENV=production kecuali flag ini true.
SEED_DEV_DATA=true
APP_URL=http://localhost:5174
API_PORT=3002
WEB_PORT=5174
# Host port mappings for db/minio (compose defaults already match these).
DB_HOST_PORT=5433
MINIO_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003
DATABASE_URL=postgresql://attendance_app:CHANGE_ME_LOCAL@db:5432/attendance_dev?schema=public
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_LOCAL_SECRET
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5174
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=attendance_local
MINIO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_LOCAL_SECRET
MINIO_BUCKET_ATTENDANCE=attendance-evidence
MINIO_BUCKET_HELP=help-media
MINIO_USE_SSL=false
BOOTSTRAP_ADMIN_USERNAME=dev-admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY
LOG_LEVEL=debug
POSTGRES_DB=attendance_dev
POSTGRES_USER=attendance_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL
MINIO_ROOT_USER=minio_local_root
MINIO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_LOCAL_SECRET
